[[0.03947368182699083, 0.2583333331665474, 0.0502331006777037, "いけなくなる。それが読者に不可欠なこととも思えない。"], [0.04238056798782904, 0.02777156804334424, 0.04410721372057502, "参考文献"], [0.043859652250241035, 0.20000000008321406, 0.05000000066690524, "文字どおり枚挙に暇がないし、原資料まで紹介しないと"], [0.044280445541205415, 0.3758741258838383, 0.04020979020979021, "最小限を列記するにとどめる。"], [0.047970482829796934, 0.3164335661713287, 0.04195804195804198, "ここでは、引用したものを中心として、トピックごとに"], [0.08118081924969235, 0.14510489517773895, 0.04020979020979021, "小著を書くにあたって参照した著述を逐一あげだすと、"], [0.08302582897703975, 0.928321678545066, 0.04020979020979021, "考察の端緒として。それぞれ畑違いながら、手頃な"], [0.08487085261761985, 0.4825174827687937, 0.0402097902097901, "まず小著の叙述全体がもとづいた拙著。"], [0.11254612190300478, 0.819930069642857, 0.04020979020979032, "一編『中国経済史」名古屋大学出版会、近刊"], [0.11254612606088561, 0.7639860139073427, 0.03321678321678323, "2011年"], [0.11439114444817175, 0.6486013985298792, 0.03321678321678323, "1999年"], [0.12177122220172194, 0.5909090911227661, 0.038461538461538436, "岡本隆司『近代中国と海関」名古屋大学出版会、"], [0.12280700838913174, 0.704166668045576, 0.04583333255527733, "ー『中国「反日」の源流』講談社選書メチェ、"]]