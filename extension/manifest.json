{
  "manifest_version": 3,
  "name": "Kindle Cloud Reader Capture",
  "version": "2.10",
  "description": "Pages through a Kindle Cloud Reader book for the ocr-kindle channel on 127.0.0.1 and sends every page image and text layer to it.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": [
      "https://read.amazon.com/*", "https://read.amazon.co.jp/*", "https://read.amazon.co.uk/*",
      "https://read.amazon.de/*", "https://read.amazon.fr/*", "https://read.amazon.es/*",
      "https://read.amazon.it/*", "https://read.amazon.ca/*", "https://read.amazon.com.au/*",
      "https://read.amazon.in/*", "https://read.amazon.com.br/*", "https://read.amazon.com.mx/*"
    ],
    "js": ["pagemeta.js", "policy.js", "content.js"]
  }, {
    "matches": [
      "https://read.amazon.com/*", "https://read.amazon.co.jp/*", "https://read.amazon.co.uk/*",
      "https://read.amazon.de/*", "https://read.amazon.fr/*", "https://read.amazon.es/*",
      "https://read.amazon.it/*", "https://read.amazon.ca/*", "https://read.amazon.com.au/*",
      "https://read.amazon.in/*", "https://read.amazon.com.br/*", "https://read.amazon.com.mx/*"
    ],
    "js": ["main.js"],
    "world": "MAIN"
  }]
}
