# Copy to config.env and fill in.

# https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional. Comma-separated models tried in order for pages without a text layer; "vision" is local macOS OCR.
# GEMINI_MODEL="gemini-3.8-flash,gemini-3.5-flash-lite,vision"

# Optional. The finished .md is copied here, e.g. a Google Drive sync folder:
# "/Users/username/Library/CloudStorage/GoogleDrive-email@gmail.com/My Drive/Kindle_md"
GOOGLE_DRIVE_FOLDER=""
