# Copy to config.env and fill in.

# https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional. Comma-separated models tried in order for pages without a text layer; "vision" is local macOS OCR.
# GEMINI_MODEL="gemini-3.8-flash,gemini-3.5-flash-lite,vision"

# Optional. The finished .md is copied here, e.g. a Google Drive sync folder:
# "/Users/username/Library/CloudStorage/GoogleDrive-email@gmail.com/My Drive/Kindle_md"
GOOGLE_DRIVE_FOLDER=""

# Optional. Where a failure's case (cases.py) is copied; default Kindle_cases beside GOOGLE_DRIVE_FOLDER.
# KINDLE_CASES_FOLDER=""

# Layout providers, first tried first. A name without its key is skipped. OpenAI is not a provider:
# its free tokens share the pages, and the books are copyrighted.
# LAYOUT_PROVIDERS="claude,gemini,mistral,glm,openrouter,ollama"

# claude -p model for layout. sonnet (default) or haiku.
# CLAUDE_MODEL="sonnet"

# https://console.mistral.ai/  — create a key, then turn off training on your workspace's data before the first book.
# MISTRAL_API_KEY=""

# https://z.ai/  GLM-4.6V-Flash is free and one request at a time.
# ZAI_API_KEY=""

# https://openrouter.ai/keys  — a :free vision model only, about 50 requests a day.
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="qwen/qwen3.8-27b:free"

# Local Ollama. No key. Used when `ollama serve` is running.
# A 16 GB M1 holds qwen2.5vl:7b (about 6 GB). An 8 GB Mac should pull qwen2.5vl:3b instead.
#   ollama pull qwen2.5vl:7b
# OLLAMA_MODEL="qwen2.5vl:7b"
